<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PartieActivity">

    <TextView
        android:id="@+id/couleur_choisie"
        style="@style/TexteLibelle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Couleur : Blancs" />

    <TextView
        android:id="@+id/creativite_choisie"
        style="@style/TexteLibelle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/couleur_choisie"
        app:layout_constraintTop_toBottomOf="@id/couleur_choisie"
        tools:text="Créativité : 0,6" />

</androidx.constraintlayout.widget.ConstraintLayout>
